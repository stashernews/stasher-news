  TERRITORY_REVENUE
  REWARDS_POOL
  ROUTING_FEE
  ROUTING_FEE_REFUND
  PROXY_PAYMENT
  TIP
  BOUNTY_PAYMENT
  REWARD
  INVITE_GIFT
  WITHDRAWAL
  SYSTEM_REVENUE
  BUY_CREDITS
  INVOICE_OVERPAY_SPILLOVER
  DEFUNCT_REFERRAL_ACT
  DEFUNCT_DELAYED_TERRITORY_REVENUE
}

// =====================================================================
// ==== STASHERNEWS MONERO OBSERVATION MODELS (spec §4.3)            ====
// =====================================================================
// All monetary columns are BigInt piconeros (1e-12 XMR). The relation
// syntax in the spec was malformed (fields:/references: swapped); it is
// reproduced here with correct Prisma syntax.

enum Network {
  STAGENET
  MAINNET
}

enum PrivacyMode {
  AUTO_INDEX
  MANUAL_PROOF
}

enum LwsAccountStatus {
  ACTIVE
  INACTIVE
  HIDDEN
}

enum SubaddressState {
  AVAILABLE
  ASSIGNED
  CONSUMED
}

enum ObservedState {
  PENDING
  DETECTED
  CONFIRMED
  REORGED
  EXPIRED
}

enum ProofType {
  INDEXED
  PROVEN
}

enum DistributionStatus {
  PENDING
  SENDING
  COMPLETE
  FAILED
}

enum PayoutState {
  QUEUED
  SENT
  CONFIRMED
  FAILED
}

// Hot-wallet ops sweep: whether the ops share of a distribution was swept out.
enum OpsSweepState {
  NOT_SWEEPED
  SWEPT
  SKIPPED_LOCKED
  FAILED
}

// StasherNews fee ledger (§6.2). Posting/territory fees land on the platform
// rewards wallet via dedicated subaddresses; the rewardsWalletObserver attributes them.
enum FeeType {
  POSTING
  TERRITORY_CREATE
  TERRITORY_BILLING
  TERRITORY_UNARCHIVE
  TERRITORY_UPDATE
  DONATE
  TIP_UNWALLETED
  BOOST
  BOUNTY_FEE
  BOUNTY_ROLLOVER
}

enum ItemFeeStatus {
  FEE_NOT_REQUIRED
  PENDING_FEE
  FEE_PAID
}

enum SubBillingStatus {
  PAID
  PENDING_FEE
  LAPSED
}

// A registered Monero wallet under observation by monero-lws.
// One row per (user, wallet) for authors; plus ONE fixed row for the platform rewards wallet.
model MoneroAccount {
  id              Int              @id @default(autoincrement())
  ownerUserId     Int?
  address         String
  label           String
  network         Network
  scanFromHeight  BigInt           @default(0)
  lastTxId        BigInt?
  lastBlockHash   String?
  status          LwsAccountStatus @default(ACTIVE)
  lwsRegisteredAt DateTime?
  createdAt       DateTime         @default(now())

  user         User?             @relation(fields: [ownerUserId], references: [id])
  viewKey      MoneroViewKey?
  subaddresses SubaddressIndex[]
  observedTips ObservedTip[]
  observedBounties ObservedBounty[]

  @@unique([address, network])
  @@index([ownerUserId])
}

// Encrypted view key (envelope encryption — never plaintext, never emailed).
model MoneroViewKey {
  id         Int       @id @default(autoincrement())
  accountId  Int       @unique
  ciphertext Bytes
  iv         Bytes
  tag        Bytes
  wrappedDek Bytes
  dekVersion Int
  createdAt  DateTime  @default(now())
  rotatedAt  DateTime?

  account MoneroAccount @relation(fields: [accountId], references: [id])
}

// Pool of pre-registered subaddress indexes for an author account.
model SubaddressIndex {
  id             Int             @id @default(autoincrement())
  accountId      Int
  majorIndex     Int
  minorIndex     Int
  address        String
  state          SubaddressState @default(AVAILABLE)
  createdAt      DateTime        @default(now())

  account MoneroAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, majorIndex, minorIndex])
  @@index([accountId, state])
}

// An observed incoming tip (the non-custodial replacement for PayInBolt11).
model ObservedTip {
  id                 BigInt        @id @default(autoincrement())
  txHash             String
  postId             Int
  tipperId           Int?
  recipientAccountId Int
  recipientMajor     Int?
  recipientMinor     Int?
  paymentId          String
  piconeros          BigInt
  height             Int?
  confirmations      Int           @default(0)
  state              ObservedState @default(DETECTED)
  proofType          ProofType     @default(INDEXED)
  txPrivateKey       String?
  webhookEventId     String?
  detectedAt         DateTime      @default(now())
  confirmedAt        DateTime?

  post             Item          @relation(fields: [postId], references: [id])
  recipientAccount MoneroAccount @relation(fields: [recipientAccountId], references: [id])

  @@unique([txHash, recipientAccountId, recipientMajor, recipientMinor])
  @@index([postId])
  @@index([state])
  @@index([state, confirmedAt])
}

// An observed downvote payment (arrives on the platform rewards wallet).
model ObservedDownvote {
  id            BigInt        @id @default(autoincrement())
  txHash        String
  postId        Int
  downvoterId   Int?
  paymentId     String
  piconeros     BigInt
  height        Int?
  confirmations Int           @default(0)
  state         ObservedState @default(DETECTED)
  detectedAt    DateTime      @default(now())
  confirmedAt   DateTime?

  post Item @relation(fields: [postId], references: [id])

  @@unique([txHash, paymentId])
  @@index([postId])
  @@index([state, confirmedAt])
}

// An observed bounty funding payment (arrives on the bounty ESCROW wallet's
// integrated address carrying a "bn:"-namespace payment_id). The webhook
// receiver (pages/api/monero/webhook.js) drives PENDING -> DETECTED -> CONFIRMED,
// mirroring ObservedTip.
model ObservedBounty {
  id                 BigInt        @id @default(autoincrement())
  txHash             String
  postId             Int
  payerId            Int?
  recipientAccountId Int
  paymentId          String
  piconeros          BigInt
  height             Int?
  confirmations      Int           @default(0)
  state              ObservedState @default(DETECTED)
  webhookEventId     String?
  detectedAt         DateTime      @default(now())
  confirmedAt        DateTime?

  post             Item          @relation(fields: [postId], references: [id])
  recipientAccount MoneroAccount @relation(fields: [recipientAccountId], references: [id])

  @@unique([txHash, paymentId])
  @@index([postId])
  @@index([state, confirmedAt])
}

// Bounty funding payment_id reverse map (created at URI-generation time).
model BountyPidMap {
  paymentId  String    @id
  postId     Int
  nonce      BigInt
  userId     Int
  expiresAt  DateTime
  consumedAt DateTime?
}

// A bounty payout from the escrow wallet: award (winner), reclaim (author, after
// expiry), or rollover (full escrow balance -> rewards wallet, after expiry).
// recipientAddress is the signer's target (winner's / author's / rewards wallet);
// feePiconeros is the platform fee moved escrow -> rewards wallet on AWARD/RECLAIM.
model BountyPayment {
  id            Int                @id @default(autoincrement())
  itemId        Int
  winnerUserId  Int
  piconeros     BigInt
  feePiconeros  BigInt             @default(0)
  recipientAddress String
  kind          BountyPayoutKind   @default(AWARD)
  txHash        String?
  feeTxHash     String?
  height        Int?
  confirmations Int                @default(0)
  state         BountyPayoutState  @default(QUEUED)
  createdAt     DateTime           @default(now())
  sentAt        DateTime?
  confirmedAt   DateTime?

  item   Item @relation(fields: [itemId], references: [id])
  winner User @relation(fields: [winnerUserId], references: [id])

  @@index([itemId])
  @@index([state])
}

enum BountyStatus {
  UNFUNDED
  PENDING_FUNDING
  DETECTED
  FUNDED
  EXPIRED
  AWARDED
  REFUNDED
  ROLLED_OVER
}

enum BountyPayoutState {
  QUEUED
  SENT
  CONFIRMED
  FAILED
}

enum BountyPayoutKind {
  AWARD
  RECLAIM
  ROLLOVER
}

// An observed posting/territory fee payment (arrives on the platform rewards
// wallet via a DEDICATED fee subaddress — major 1 = posting, major 2 = territory).
// The rewardsWalletObserver attributes each fee output to its pending PayIn and flips the
// linked Item.feeStatus / Sub.billingStatus to paid. Phase 4's rewardsDistributor
// sums these per period. postId/subName are denormalized for the rewards ledger.
model FeeObservation {
  id             BigInt        @id @default(autoincrement())
  txHash         String
  payInId        Int?          @unique
  feeType        FeeType
  postId         Int?
  subName        String?       @db.Citext
  recipientMajor Int
  recipientMinor Int
  piconeros      BigInt
  height         Int?
  confirmations  Int           @default(0)
  state          ObservedState @default(DETECTED)
  detectedAt     DateTime      @default(now())
  confirmedAt    DateTime?

  payIn PayIn? @relation(fields: [payInId], references: [id])

  @@unique([txHash, recipientMajor, recipientMinor])
  @@index([payInId])
  @@index([feeType, state])
  @@index([state, confirmedAt])
}

// One weekly rewards distribution run.
model RewardDistribution {
  id                     Int                @id @default(autoincrement())
  periodStart            DateTime
  periodEnd              DateTime
  poolPiconeros          BigInt
  distributedPiconeros   BigInt             @default(0)
  rolledOverPiconeros    BigInt             @default(0)
  payoutCount            Int                @default(0)
  status                 DistributionStatus @default(PENDING)
  startedAt              DateTime?
  completedAt            DateTime?
  opsInflowPiconeros     BigInt             @default(0)
  opsRolledOverPiconeros BigInt             @default(0)
  opsAvailablePiconeros  BigInt             @default(0)
  opsSweptPiconeros      BigInt             @default(0)
  opsSweepTxHash         String?
  opsSweepState          OpsSweepState      @default(NOT_SWEEPED)

  payouts RewardPayout[]
  earns   Earn[]
}

// A single curator payout within a distribution (real on-chain tx from the hot wallet).
model RewardPayout {
  id               Int         @id @default(autoincrement())
  distributionId   Int
  curatorId        Int
  recipientAddress String
  piconeros        BigInt
  txHash           String?
  state            PayoutState @default(QUEUED)
  createdAt        DateTime    @default(now())

  distribution RewardDistribution @relation(fields: [distributionId], references: [id])
  curator      User               @relation(fields: [curatorId], references: [id])

  @@index([distributionId])
}

// Downvote payment_id reverse map (created at URI-generation time).
model DownvotePidMap {
  paymentId  String    @id
  postId     Int
  nonce      Int
  userId     Int
  expiresAt  DateTime
  consumedAt DateTime?
}

// Fee configuration (platform-wide singleton row, id=1).
model PlatformFeeConfig {
  id                             Int    @id @default(1)
  requiredConfirmations          Int    @default(10)
  minTipPiconeros                BigInt @default(100000000)
  defaultDownvotePiconeros       BigInt @default(1000000000)
  downvoteMinPiconeros           BigInt @default(100000000)
  freePostThresholdPiconeros     BigInt @default(10000000000)
  freePostMinAgeDays             Int    @default(7)
  postingFeeFloorPiconeros       BigInt @default(1000000000)
  territoryMonthlyPiconeros      BigInt @default(20000000000)
  territoryYearlyPiconeros       BigInt @default(200000000000)
  territoryOncePiconeros         BigInt @default(1000000000000)
  // allocation to rewards vs ops, per source (accounting-level; §6.4)
  downvoteRewardsPct             Int    @default(100)
  postingFeeRewardsPct           Int    @default(70)
  territoryFeeRewardsPct         Int    @default(30)
  // wallet-less author tips (TIP_UNWALLETED): % of inflow allocated to the
  // curator rewards pool; the remainder is the ops share. Default 50.
  walletlessTipRewardsPct        Int    @default(50)
  // boosts (BOOST fee observations): % of inflow allocated to the curator
  // rewards pool; the remainder is the ops share. Default 50 (operator, 2026-08-10).
  boostRewardsPct               Int    @default(50)
  // bounties (A-13): fee = max(bountyFeeMinPiconeros, bountyFeePct% of the
  // bounty) -> 100% ops; expiry window in days from funding confirmation.
  bountyFeeMinPiconeros BigInt @default(10000000000)
  bountyFeePct          Int    @default(1)
  bountyExpiryDays      Int    @default(30)
  // rewards distribution
  distributionTopN               Int    @default(100)
  distributionMinPayoutPiconeros BigInt @default(1000000000)
}
