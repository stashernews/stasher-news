model PayIn {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  piconeros BigInt

  payInType           PayInType
  payInState          PayInState
  payInFailureReason  PayInFailureReason?
  payInStateChangedAt DateTime            @default(now())
  genesisId           Int? // the original payIn that was retried
  successorId         Int?                @unique // this ensures a payIn can only be retried once
  retryCount          Int                 @default(0)
  benefactorId        Int?

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // StasherNews (§4.2): Monero URI / observed-tip / observed-downvote linkage
  moneroUri      String?
  paymentId      String?
  observedTipId  BigInt?
  observedDownvoteId BigInt?
  // StasherNews fee linkage (§6.2): the rewards-wallet fee subaddress this PayIn
  // watches. The detected FeeObservation is reached via the `feeObservation`
  // back-relation (1:1, FK on FeeObservation.payInId) rather than a redundant scalar.
  moneroSubaddressMajor Int?
  moneroSubaddressMinor Int?

  genesis       PayIn?        @relation("PayInGenesis", fields: [genesisId], references: [id], onDelete: Cascade)
  successor     PayIn?        @relation("PayInSuccessor", fields: [successorId], references: [id], onDelete: Cascade)
  predecessor   PayIn?        @relation("PayInSuccessor")
  benefactor    PayIn?        @relation("PayInBenefactor", fields: [benefactorId], references: [id], onDelete: Cascade)
  beneficiaries PayIn[]       @relation("PayInBenefactor")
  itemPayIn     ItemPayIn?
  subPayIn      SubPayIn?
  progeny       PayIn[]       @relation("PayInGenesis")
  pollVote      PollVote?
  uploadPayIns  UploadPayIn[]
  // back-relations for the fee 1:1 linkages (Item.feePayIn / Sub.billingPayIn /
  // FeeObservation.payIn). The FKs live on the other side; these are the read sides.
  feeItem       Item?          @relation("ItemFeePayIn")
  feeSub        Sub?           @relation("SubBillingPayIn")
  feeObservation FeeObservation?

  @@index([userId])
  @@index([createdAt])
  @@index([payInType])
  @@index([genesisId])
  @@index([payInState])
  @@index([benefactorId])
  @@index([payInStateChangedAt])
  @@index([userId, payInState, payInStateChangedAt, payInType])
  @@index([id, payInType, payInState, userId])
}

