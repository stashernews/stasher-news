# --- Monero mainnet (Phase 6 Workstream A) ---
# Network the monerod / monero-lws stack runs on. Prod is mainnet only; stagenet
# belongs in .env.development.
MONERO_NETWORK=mainnet
# Client-visible mirror so the wallet-setup UI validates addresses with monero-ts
# against the same network the server uses.
NEXT_PUBLIC_MONERO_NETWORK=mainnet
# monerod listen ports per network (mainnet 18xxx / stagenet 38xxx / testnet 28xxx).
MONEROD_RPC_PORT=18081
MONEROD_ZMQ_RPC_PORT=18082
MONEROD_ZMQ_PUB_PORT=18083
# monerod JSON-RPC over the Docker network. monero-lws derives its --daemon/--sub
# from MONERO_NETWORK + the ZMQ port vars above (tcp://monerod:<port>); the ZMQ
# URL lines are set explicitly so lws can also be pointed at a remote monerod.
MONEROD_URL=http://monerod:18081
MONEROD_ZMQ_RPC_URL=tcp://monerod:18082
MONEROD_ZMQ_PUB_URL=tcp://monerod:18083
# monero-lws public + admin endpoints over the Docker network.
MONERO_LWS_URL=https://monero-lws:8443
MONERO_LWS_ADMIN_URL=https://monero-lws:8081/admin
# Admin auth key from `monero-lws-admin create_admin`. Put the real secret in
# .env.local when lws runs with admin auth enabled.
MONERO_LWS_ADMIN_AUTH=
# lws serves a real cert in prod; the dev stagenet default (true) MUST NOT carry
# over. Set true only behind a trusted reverse proxy terminating TLS — never on
# the open internet.
MONERO_LWS_INSECURE_TLS=false
MONERO_LWS_TIMEOUT_MS=15000
MONERO_LWS_MAX_RETRIES=3
# Webhook receiver URL (lws calls this with tx-confirmation callbacks). As long
# as lws and the app share the Docker network, the internal address is correct
# and avoids a public round-trip; switch to the public URL only if lws is split
# to a separate host.
LWS_WEBHOOK_URL=http://app:3000/api/monero/webhook
# Shared secret lws echoes back in the x-lws-token header. REQUIRED in prod (empty
# = no auth check, dev-only). Set a strong secret in .env.local.
LWS_WEBHOOK_TOKEN=

# --- Platform rewards wallet (§5.6 / §6.2) ---
# The ONLY custodial component. Posting + territory fees land here via dedicated
# subaddresses; downvotes too. The next two lines are PUBLIC transparency values
# and are safe to commit here once the mainnet wallet is provisioned (Task A6);
# leave empty until then.
PLATFORM_REWARDS_ADDRESS=
PLATFORM_REWARDS_VIEW_KEY=
# The SPEND key is a SECRET — put it ONLY in gitignored .env.local, never in this
# tracked file. It is read solely by the offline derive-fee-pool step and the
# worker's fee-pool auto top-up (worker/rewardsWalletObserver.js), never by the
# app runtime. Uncomment + set in .env.local only:
#   PLATFORM_REWARDS_SPEND_KEY=
# Rewards wallet rescan anchor + fee-pool sizing.
REWARDS_SCAN_FROM_HEIGHT=0
POSTING_FEE_POOL_SIZE=2000
TERRITORY_FEE_POOL_SIZE=200
FEE_POOL_TOPUP_THRESHOLD=100

# --- Cold storage (Workstream B) ---
# Offline ops/cold wallet the weekly distribution sweeps the hot wallet to so the
# hot wallet trends to ~zero between cycles (§6.4). Commit only the public address
# here; the cold spend key NEVER touches a server. Consumed by Workstream B's ops
# sweep; leave empty until that lands and the wallet is generated (Task A6).
REWARDS_COLD_STORAGE_ADDRESS=

# VIEWKEY_MASTER_KEY — AES-256-GCM envelope master key for every MoneroViewKey
# row. Set in gitignored .env.local, never here (this file is tracked in git).
# MUST be backed up per docs/ops/master-key-escrow.md: an offline copy AND an
# encrypted blob (scripts/backup-master-key.sh) stored separately from the DB
# backups. Losing it is unrecoverable data loss.

# DB_ARCHIVE_MODE — set DB_ARCHIVE_MODE=on in .env.local to enable Postgres WAL
# archiving + PITR (a separate failure domain from the nightly pg_dump). Off by
# default; enabling requires a base backup + offsite WAL shipping. See
# docs/ops/postgres-durability.md.
