# Stasher News onion mirror — see docs/onion-mirror.md
# This instance is an ingress source ONLY: no relay, no exit, no control
# port. SOCKS is bound to container loopback for manual diagnostics only
# (docs/onion-mirror.md section 8); the healthcheck probes the serving path directly.
# the overlay runs this container with network_mode: "service:caddy", so loopback :8081 IS the caddy onion listener (tor 0.4.9 parses IP literals only)
Log notice stdout
DataDirectory /tordata/data
SOCKSPort 127.0.0.1:9050
HiddenServiceDir /tordata/hs/
HiddenServiceVersion 3
HiddenServicePort 80 127.0.0.1:8081
