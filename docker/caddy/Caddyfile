# Local TLS terminator for custom-domain dev. Mirrors prod, where the AWS ALB
# terminates HTTPS via ACM and forwards plain HTTP to the app.
#
# On-demand TLS with `tls internal` mints a per-SNI cert from Caddy's local CA
# the first time a hostname is hit, so any dev custom domain (whatever
# /etc/hosts or dnsmasq points at 127.0.0.1) works without per-domain config.
#
# Run `./sndev domains trust` once to install Caddy's local root CA into the
# host trust store; after that browsers see a real green padlock and the page
# is treated as a secure context (window.crypto.subtle, secure cookies, etc.).
{
	auto_https disable_redirects
	local_certs

	# Caddy refuses on-demand TLS without an "ask" endpoint, to prevent SNI
	# floods from forcing it to mint unbounded certs. In dev we self-host a
	# loopback-only allow-all ask on :5555 so any SNI is allowed without
	# wiring up an external service.
	on_demand_tls {
		ask http://127.0.0.1:5555/
	}

	log {
		output stderr
		level WARN
	}
}

# Loopback-only ask endpoint: any GET /?domain=<sni> returns 200, so Caddy
# mints a cert for any incoming SNI. Bound to localhost so nothing outside the
# container can reach it.
http://127.0.0.1:5555 {
	respond 200
}

# HTTPS catch-all: terminate TLS with the local CA, reverse-proxy to Next.js.
(deny_admin) {
	@admin path /admin /admin/* /api/admin /api/admin/*
	handle @admin {
		respond 404
	}
}

:443 {
	tls internal {
		on_demand
	}
	encode zstd gzip
	import deny_admin
	@maintenance file {
		root /srv/maintenance-flag
		try_files enabled
	}
	handle @maintenance {
		root * /srv/maintenance
		rewrite * /index.html
		file_server {
			status 503
		}
		header Retry-After 3600
	}

	# lws confirmation webhook: internal-only. lws delivers container-to-container
	# (direct to app:3000), never through the edge, so any public hit is a probe or
	# forgery attempt — 404 before the catch-all proxy.
	@webhook path /api/monero/webhook /api/monero/webhook/*
	handle @webhook {
		respond 404
	}

	handle {
		reverse_proxy app:3000 {
			header_up -X-Admin-Gate
			# preserve the original Host so proxy.js's getDomainMapping(host) sees
			# the user-facing custom domain, not "app:3000"
			header_up Host {host}
			# Tell Next.js the browser-facing request was HTTPS so dev cookies that
			# depend on Secure, like sn_referrer, match the TLS-terminated origin.
			header_up X-Forwarded-Proto https
			# overwrite (not append) the client-supplied X-Forwarded-For: without
			# this, Caddy appends the real IP AFTER any spoofed entries the client
			# sent, and the app's rightmost-entry parser is the only defense
			header_up X-Forwarded-For {remote_host}
		}
	}
}

# HTTP -> HTTPS, mirroring the prod ALB redirect.
:80 {
	import deny_admin
	handle {
		redir https://{host}{uri} 308
	}
}

# Restricted operational listener. Host publishing is loopback-only in compose.
http://:9443 {
	# Only loopback names reach the app. Any other Host is a DNS-rebinding
	# page riding the operator's open tunnel; it must not receive the gate.
	@foreign not host 127.0.0.1 localhost
	handle @foreign {
		respond 404
	}
	@adminpaths path /admin /admin/* /api/admin /api/admin/* /_next/* /fonts/* /icons/*
	handle @adminpaths {
		reverse_proxy app:3000 {
			header_up Host stasher.news
			header_up X-Forwarded-Proto http
			header_up X-Admin-Gate {env.ADMIN_GATE_SECRET}
			# Next also sets HSTS outside middleware; the SSH listener is HTTP.
			header_down -Strict-Transport-Security
		}
	}
	handle {
		respond 404
	}
}
