# Production TLS terminator for stasher.news. Automatic Let's Encrypt:
# Caddy answers the HTTP-01 challenge on :80, issues/renews the cert, and
# redirects http -> https — no manual cert management. Certificates persist
# in the caddy_data named volume across restarts.
#
# Dev-only machinery (local_certs, on_demand_tls, the internal CA, the :5555
# ask endpoint) is deliberately absent — this file must never mint internal
# certs. Select it by setting CADDYFILE=./docker/caddy/Caddyfile.prod.
{
	# Let's Encrypt account contact for expiry/renewal notices. Publicly
	# visible in certificate transparency logs.
	email security@stasher.news
}

(deny_admin) {
	@admin path /admin /admin/* /api/admin /api/admin/*
	handle @admin {
		respond 404
	}
}

# Shared ingress handlers for the main site: imported by the clearnet
# stasher.news site (https) and the onion-mirror listener (http://:8081)
# so the two ingress paths cannot drift. {args[0]} is the truthful
# X-Forwarded-Proto for the importing path.
(ingress) {
	encode zstd gzip
	import deny_admin

	# Flag state is separate from the read-only static maintenance page.
	@maintenance file {
		root /srv/maintenance-flag
		try_files enabled
	}
	handle @maintenance {
		root * /srv/maintenance
		rewrite * /index.html
		file_server {
			status 503
		}
		header Retry-After 3600
	}

	# Media uploads: same-origin /uploads is reverse-proxied to the media S3
	# service (SeaweedFS behind an HTTP-only proxy). See the long comment in
	# git history for the bucket-root-vs-key matcher rationale.
	@uploads path /uploads /uploads/*
	handle @uploads {
		reverse_proxy minio:9000 {
			header_up -X-Admin-Gate
		}
	}

	# lws confirmation webhook: internal-only (404 before the catch-all).
	@webhook path /api/monero/webhook /api/monero/webhook/*
	handle @webhook {
		respond 404
	}

	handle {
		reverse_proxy app:3000 {
			header_up -X-Admin-Gate
			# preserve the original Host so proxy.js's getDomainMapping(host)
			# sees the user-facing domain, not "app:3000"
			header_up Host {host}
			# overwrite (not append) the client-supplied X-Forwarded-For (audit B-2)
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {args[0]}
		}
	}
}

stasher.news {
	import ingress https
	# Tor Browser offers clearnet visitors a one-click switch to the onion
	# mirror; honored on HTML responses per the Onion-Location spec. Gated on
	# ONION_HOST so the pre-key-day state (env unset) emits no header instead
	# of a garbage http:/// value.
	@onionReady expression `{env.ONION_HOST} != ""`
	header @onionReady Onion-Location "http://{$ONION_HOST}{uri}"
}

# Onion mirror ingress: host-agnostic on purpose so the onion address never
# appears in Caddy config (no chicken-and-egg with the unknown-at-build-time
# hostname; a future address change needs no Caddyfile edit). `bind 127.0.0.1`
# keeps the listener loopback-only — its only network peer is the onion-tor
# container, which shares caddy's netns (network_mode: "service:caddy") and
# reaches this listener via 127.0.0.1:8081. Nothing else on the box can reach
# it, and no host port is published.
http://:8081 {
	bind 127.0.0.1
	import ingress http
}

# Image rendering host. Client-rendered image URLs carry an imgproxy path prefix
# (NEXT_PUBLIC_IMGPROXY_URL); stored paths are root-relative, so they map 1:1
# onto this host. Cert is issued via the global Let's Encrypt automation above.
media.stasher.news {
	encode zstd gzip
	import deny_admin
	handle {
		reverse_proxy imgproxy:8080 {
			header_up -X-Admin-Gate
			# imgproxy trusts these headers for client_ip logging; keep visitor IPs out.
			header_up -X-Forwarded-For
			header_up -CF-Connecting-IP
			header_up -X-Real-IP
		}
	}
}

# Capture service host. Serves the 1200x630 og:image screenshots wired in
# components/seo.js. Cert is issued via the global Let's Encrypt automation
# above. The XFF overwrite mirrors the app block (audit B-2).
capture.stasher.news {
	encode zstd gzip
	import deny_admin
	handle {
		reverse_proxy capture:5678 {
			header_up -X-Admin-Gate
			header_up X-Forwarded-For {remote_host}
		}
	}
}

# www -> apex. www.stasher.news resolves in DNS but had no site block, so
# www visitors got no certificate and no serve path. 301 preserves path+query.
www.stasher.news {
	import deny_admin
	handle {
		redir https://stasher.news{uri} permanent
	}
}

# Restricted operational listener. Host publishing is loopback-only in compose.
http://:9443 {
	# Only loopback names reach the app. Any other Host is a DNS-rebinding
	# page riding the operator's open tunnel; it must not receive the gate.
	@foreign not host 127.0.0.1 localhost
	handle @foreign {
		respond 404
	}
	@adminpaths path /admin /admin/* /api/admin /api/admin/* /_next/* /fonts/* /icons/*
	handle @adminpaths {
		reverse_proxy app:3000 {
			header_up Host stasher.news
			header_up X-Forwarded-Proto http
			header_up X-Admin-Gate {env.ADMIN_GATE_SECRET}
			# Next also sets HSTS outside middleware; the SSH listener is HTTP.
			header_down -Strict-Transport-Security
		}
	}
	handle {
		respond 404
	}
}
